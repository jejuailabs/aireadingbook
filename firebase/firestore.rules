rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.get('role', '') == 'admin'; }
    function staff() { return signedIn() && request.auth.token.get('role', '') in ['admin', 'editor']; }
    match /users/{uid} {
      allow read: if owns(uid) || admin();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'locale', 'theme', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.locale in ['ko', 'en']
        && request.resource.data.theme in ['light', 'dark'];
      allow delete: if false;
      match /library/{id} { allow read, write: if owns(uid); }
      match /collections/{id} { allow read, write: if owns(uid); }
      match /recordings/{id} { allow read, write: if owns(uid); }
    }
    // Publishing and rights reviews go through a verified server, never client writes.
    match /catalog/{id} {
      allow read: if resource.data.status == 'published' || staff();
      allow write: if false;
    }
    match /productionJobs/{id} {
      allow read: if admin() || (signedIn() && resource.data.requestedBy == request.auth.uid);
      allow write: if false;
    }
    match /auditLog/{id} { allow read: if admin(); allow write: if false; }
    match /billingApprovals/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
