# Copy to .env.local for local server configuration.
# Server-only credentials are intentionally empty.
# Do not commit real credentials. Paid usage requires separate approval.
# Local narration CLI loads these variables; the static browser app does not.
NARRATION_ENABLED=false
NARRATION_PROVIDER=runpod-qwen3
NARRATION_API_KEY=
NARRATION_API_BASE_URL=https://api.runpod.ai/v2
NARRATION_MODEL=Qwen3-TTS-12Hz-1.7B-CustomVoice
NARRATION_VOICE_ID=Sohee
# RunPod credential is server/local-runner only. Never copy a real key here.
RUNPOD_API_KEY=
RUNPOD_QWEN3_TTS_ENDPOINT_ID=

# Server-only Firebase Admin service account JSON. Never commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON=
